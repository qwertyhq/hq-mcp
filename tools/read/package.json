{
  "name": "@hq/tools-read",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "tsc -b tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hq/budget": "workspace:*",
    "@hq/redact": "workspace:*",
    "@hq/registry": "workspace:*",
    "@hq/remna": "workspace:*",
    "@hq/shm": "workspace:*",
    "@hq/types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hq/exec": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
