# hq-mcp configuration. Copy to .env and fill in.
# .env is gitignored. Never commit real values.

# ─── Backends: at least ONE pair, not all four ───────────────────────────────
#
# The server runs against SHM, against Remnawave, or against both. Each pair
# below is a complete configuration on its own; what is NOT allowed is neither.
#
#   SHM_BASE_URL + SHM_ADMIN_AUTH        the billing
#   REMNA_BASE_URL + REMNA_API_TOKEN     the panel
#
# Configure both only if you actually run both. A pair you leave out is not a
# degraded server: the tools that need that system are not published at all, so
# the model never sees a capability this installation does not have. Two of them
# need BOTH systems and appear only when both are configured — sync_audit, which
# compares billing against panel, and provisioning_diagnose, which checks
# whether SHM's provisioning reached the panel. Neither has a question to answer
# with one side missing.
#
# platform_probe is always published and says which backends are configured, so
# an agent learns the shape of this deployment from one call rather than from a
# string of refusals. `pnpm setup` asks the same question first and then only
# asks for the credentials of the systems you said you have.
#
# HALF A PAIR IS AN ERROR, NOT A CHOICE: setting SHM_BASE_URL without
# SHM_ADMIN_AUTH stops the server by name of the missing variable. Dropping the
# backend quietly would hide thirteen tools with no explanation anywhere, and a
# typo in a variable name is a mistake — not a deployment decision.

# SHM billing API root, including the version segment. No trailing slash needed.
SHM_BASE_URL=https://billing.example.com/shm/v1

# SHM admin credentials. Either "login:password" (encoded to Basic for you) or a
# ready "Basic <base64>" value.
SHM_ADMIN_AUTH=login:password

# Remnawave panel root.
REMNA_BASE_URL=https://panel.example.com

# Remnawave API token (a JWT with the API role). Sent as the Bearer header.
REMNA_API_TOKEN=

# ─── Optional: behaviour ─────────────────────────────────────────────────────

# ro registers read tools only; rw additionally registers the mutators, which
# change live billing and the live panel behind a plan → plan_id → apply step.
# Default: ro.
HQ_MCP_MODE=ro

# human is a trusted operator at a terminal and gets specific refusal messages.
# bot is an untrusted channel and gets a uniform "not found" for every case, so
# the tool list cannot be enumerated by probing. Default: human.
HQ_MCP_PROFILE=human

# The timezone SHM's server runs in. SHM writes dates with strftime(localtime)
# and no offset, so reading them in the wrong zone shifts every task age by that
# offset — silently, since nothing in the payload says which zone it meant.
# Default: Europe/Moscow.
HQ_MCP_SHM_TZ=Europe/Moscow

# ─── Optional: the HTTP transport ────────────────────────────────────────────
# Only `apps/http` reads these. The stdio server ignores them, and a client that
# spawns the stdio binary itself needs none of this.
#
# The HTTP server publishes the SAME tools over MCP at /mcp (streamable HTTP,
# sessionless) plus a REST facade at /v1/tools for the support bot. Use it when
# the client cannot spawn a process: it runs in a container, on another machine,
# or there is more than one of it.

# Who may call, as "<label>:<token>[,<label>:<token>]". EMPTY IS NOT A DEFAULT:
# the server refuses to start without it, before it builds any client to the
# billing or the panel, because the alternative is an unauthenticated server
# holding production credentials. The label is what shows up in /metrics and in
# the startup line, so it is visible who is calling without printing the token.
# Each client gets its own token: duplicates are rejected at startup, since one
# token under two labels makes the byClient breakdown lie and revoking one line
# revokes nothing. Minimum 24 characters. Generate with `openssl rand -hex 24`.
# HQ_MCP_HTTP_TOKENS=<label>:<token>

# Where to listen. Default 127.0.0.1: everything outside reaches this server
# through a reverse proxy on the same host. Set 0.0.0.0 only deliberately — the
# server prints a warning when it binds anything but loopback, because then that
# bearer token is the only thing between production credentials and the network.
# HQ_MCP_HTTP_HOST=127.0.0.1

# Default 42480.
# HQ_MCP_HTTP_PORT=42480

# ─── Optional: how this installation names its objects ───────────────────────
# Normally you do NOT set these. SHM provisions one panel user per service and
# one storage snapshot beside it, both named "<prefix><user_service_id>", and
# the provisioning template computes both prefixes from its own configuration:
#   STORAGE_PREFIX = config.remnawave.storage_prefix || "vpn_mrzb_"
#   NAME_PREFIX    = config.remnawave.name_prefix    || "HQVPN_"
# The server reads that same config key live (GET /admin/config/remnawave) and
# follows whatever your SHM says, falling back to the two defaults above when
# the key is absent — which is the usual case.
#
# Set these only when the live value is not the whole truth, and it is worth
# knowing what goes wrong when they are wrong: the panel username is the ONLY
# key joining a service to its panel account, so a prefix that matches nothing
# does not produce an error — it produces a confident wrong answer, in which
# every service looks unprovisioned. Tools that can prove that has happened say
# so with the warning code `prefix_unverified` rather than reporting findings.

# Prefix of the SHM storage key holding a service's configuration snapshot.
# HQ_MCP_STORAGE_PREFIX=vpn_mrzb_

# EVERY panel username prefix this install has ever used, comma-separated, the
# current one FIRST — the order is what decides which of two accounts naming the
# same service is treated as canonical. Set it when accounts created under an
# older prefix are still live, or when you changed name_prefix and did not
# rename what already existed: the config key says what SHM will build next,
# this says what the panel holds today. Setting it replaces the built-in list
# entirely (HQVPN_, plus this deployment's own legacy remnawave_ and us_).
# HQ_MCP_PANEL_PREFIXES=HQVPN_,remnawave_,us_

# Storage keys owned by your APPLICATIONS, comma-separated. These are the only
# names storage_edit will write besides the per-service snapshot above, and they
# are the one part of that list nothing can derive: the snapshot key is built
# from a prefix SHM itself computes, but an application key is just a string
# chosen in that application's own source — here, the mini app writing device
# names (wbap/src/lib/api/deviceNames.ts). A different install runs a different
# app and therefore a different key, so the default below is this deployment's
# fact, not a universal one. Setting this REPLACES the default rather than
# extending it: an allowlist that only ever grows is not an allowlist.
# Worker rows (wh_*, whevt_*) are refused here no matter what you put in — those
# are written by the workers themselves, and contention on one shared storage
# row is what hung core on 2026-07-10.
# HQ_MCP_STORAGE_APP_KEYS=wbap_device_names

# Local request gate, shared across all tools. The default is deliberately half
# of what SHM itself throttles at, because the same bucket is shared with other
# clients of the same backend. Batch listing routes have their own higher
# ceilings in packages/budget.
HQ_MCP_BUDGET_LIMIT=30
HQ_MCP_BUDGET_WINDOW_MS=60000

# Ceiling on a single money operation, in the billing's own currency. The
# framework refuses a mutation above it before building a plan, so a tool that
# forgets its own check is still bounded. Required once mutations are enabled.
#
# It covers BOTH kinds of money movement, and the second one is easy to forget:
# payments and bonuses, where the caller names the sum, and service lifecycle
# actions that spend the client's balance (give / touch / change_plan /
# activate), where the sum is the tariff price and the plan has to read it from
# the catalogue. A lifecycle plan whose price cannot be read is refused rather
# than waved through — not knowing the number does not make the charge free.
#
# Size it against your own catalogue, not against this file: the ceiling has to
# sit above your most expensive tariff, or ordering that tariff stops working.
# The built-in default is 5000, which is lower than the value below.
HQ_MCP_MAX_OP_AMOUNT=10000

# Ceiling on how many panel clients ONE bulk operation may touch. The plan has
# to establish that number from the panel first; above this it is refused.
# Default 100. Fleet-wide routes (/api/users/bulk/all/*) touch every account,
# so with any value below the fleet size they simply never pass — that is the
# point of the ceiling, not a bug. Raise it deliberately, per operation.
HQ_MCP_MAX_BULK_USERS=100

# ─── Optional: private-network tools ─────────────────────────────────────────
# abuse_report and sql_query reach services that are not published to the
# internet. Without a tunnel they refuse with the exact command to open one,
# which is why they stay visible rather than disappearing from the tool list.

# Host the tunnel forwards to locally.
HQ_MCP_TUNNEL_HOST=127.0.0.1

# Anti-abuse hook, reachable only inside the internal network.
HQ_MCP_TUNNEL_ABUSE_URL=http://127.0.0.1:18099

# The hook authenticates with this header. Without it every call gets 403, and
# the tool would blame the tunnel for an authentication failure.
HQ_MCP_GUARD_HOOK_TOKEN=

# Forwarded database ports. MySQL is unset by default because SHM does not
# publish 3306 at all; sql_query refuses and says so rather than hanging.
HQ_MCP_TUNNEL_PG_PORT=16767
# HQ_MCP_TUNNEL_MYSQL_PORT=13306

# Printed verbatim in the refusal when a tunnel is closed, so the operator can
# copy it. Set it to the command your deployment actually uses.
HQ_MCP_TUNNEL_SSH=ssh -L 18099:hook-host:8099 -L 16767:db-host:6767 your-jump-host

# ─── Optional: paths ─────────────────────────────────────────────────────────
# Used by the mutation release; harmless here.
# HQ_MCP_AUDIT_PATH=./.hq-mcp/audit.jsonl
# HQ_MCP_SNAPSHOT_DIR=./.hq-mcp/snapshots

# Where template_edit and storage_edit put the previous content before they
# overwrite it. That snapshot IS the rollback: the tools refuse to write when
# they cannot take one, and restore_from reads it back from here. Keep it on a
# disk that survives the machine — a template body has no git history anywhere
# else. The files hold raw billing logic and raw client credentials, so the
# directory is created 0700 and the files 0600; the default keeps them under
# .hq-mcp/, which .gitignore already excludes for exactly that reason.
# HQ_MCP_BACKUP_DIR=./.hq-mcp/backups

# Shared secret for SHM's public endpoints. Only needed if you use them.
# SHM_PUBLIC_SECRET=

# ─── Optional: the fixture-capture harness ───────────────────────────────────
# Only `pnpm probe:stands` reads these; the server ignores them.

# Your production hosts, comma-separated. The harness refuses to capture from
# any of them — and from their subdomains — so a mistyped stand URL cannot write
# live customer data into a fixture that then goes to git forever. It lives here
# rather than in the source because this repository is public. Leave it unset
# and the harness refuses to run at all: a guard that permits everything when
# unconfigured is worse than none, because you still believe it is there.
HQ_STAND_FORBIDDEN_HOSTS=billing.example.com,panel.example.com
